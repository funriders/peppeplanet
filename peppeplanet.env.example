# Copy to peppeplanet.env (not committed). Coolify injects these as env vars.

SECRET_KEY=change-me-to-a-long-random-string

DB_NAME=peppeplanet_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

DEBUG=False

# Optional (defaults in settings.py include dev)
